# Copy to .env.local (git-ignored) and fill in - read by process_logs*.sh.
# SFTP logins of the game servers the ladder fetches its logs from.

# [aCKa] servers: user@host and private key file
ACKA_SSH="user@acka-host"
ACKA_SSH_KEY="/path/to/id_acka"

# Chobbz servers
CHOBBZ_SSH="user@chobbz-host"
CHOBBZ_SSH_KEY="/path/to/id_chobbz"
