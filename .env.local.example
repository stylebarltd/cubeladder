# Copy to .env.local (git-ignored) and fill in - read by process_logs*.sh.
# SFTP logins of the game servers the ladder fetches its logs from.

# [aCKa] servers: user@host and private key file
ACKA_SSH="user@acka-host"
ACKA_SSH_KEY="/path/to/id_acka"

# Chobbz servers
CHOBBZ_SSH="user@chobbz-host"
CHOBBZ_SSH_KEY="/path/to/id_chobbz"

# Barry's B server: plain FTP (process_logs.sh fetches the newest serverlog_*.txt)
B_FTP_HOST="107.173.23.18"
B_FTP_PORT="2121"
B_FTP_USER="user"
B_FTP_PASS="password"
# optional: directory with the logs (default /) and the part of the file name to pick (default "local")
#B_FTP_DIR="/"
#B_FTP_MATCH="local#28763"
# optional: the first log date to import (default 20261008)
#B_FTP_SINCE="20261008"

# Vortex servers: their logs come from a Cloudflare gateway over HTTPS
# (fetch_vortex_logs.sh). Private download token from the Vortex admin.
VORTEX_TOKEN=
# optional: first log date to import (yyyymmdd, default 20261024)
#VORTEX_SINCE=
